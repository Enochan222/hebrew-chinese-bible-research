{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hebrew-chinese-bible-research.local/schemas/v1.1/annotation-layer.schema.json",
  "title": "AnnotationLayer v1.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "annotationLayerId",
    "corpusReleaseId",
    "annotationFrameworkId",
    "layerKind",
    "layerVersion"
  ],
  "properties": {
    "annotationLayerId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "corpusReleaseId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "annotationFrameworkId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "layerKind": {
      "enum": [
        "ORTHOGRAPHIC_SEGMENTATION",
        "MORPHEME_SEGMENTATION",
        "MORPHOLOGY",
        "PHRASE_STRUCTURE",
        "CLAUSE_STRUCTURE",
        "DEPENDENCY",
        "SEMANTIC_ROLE",
        "DISCOURSE",
        "WORD_SENSE"
      ]
    },
    "layerVersion": {
      "type": "string",
      "minLength": 1
    },
    "sourceRegistryId": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "provenanceId": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "rightsPolicyId": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "contentHash": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-fA-F]{64}$"
    }
  }
}

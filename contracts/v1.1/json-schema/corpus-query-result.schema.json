{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hebrew-chinese-bible-research.local/schemas/v1.1/corpus-query-result.schema.json",
  "title": "CorpusQueryResultV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "researchReleaseId",
    "normalizedQueryHash",
    "queryExecutionPolicyVersion",
    "epistemicClass",
    "matchCount",
    "matches"
  ],
  "properties": {
    "researchReleaseId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "normalizedQueryHash": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "queryExecutionPolicyVersion": {
      "type": "string",
      "minLength": 1
    },
    "epistemicClass": {
      "enum": [
        "CORPUS_COMPLETE",
        "FRAMEWORK_COMPLETE",
        "CURATED_SET_COMPLETE",
        "HEURISTIC_CANDIDATE",
        "INCOMPLETE_COVERAGE"
      ]
    },
    "matchCount": {
      "type": "integer",
      "minimum": 0
    },
    "constructionCount": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "clauseCount": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "referenceSpanCount": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "matches": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "referenceSpanId",
          "bindings",
          "whyMatched",
          "sortKey"
        ],
        "properties": {
          "referenceSpanId": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
          },
          "bindings": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "whyMatched": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sortKey": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "nextCursor": {
      "type": [
        "string",
        "null"
      ]
    },
    "dependencyManifest": {
      "type": "object",
      "additionalProperties": true
    }
  }
}

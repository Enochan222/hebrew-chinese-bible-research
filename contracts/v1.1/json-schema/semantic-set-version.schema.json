{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hebrew-chinese-bible-research.local/schemas/v1.1/semantic-set-version.schema.json",
  "title": "SemanticSetVersion v1.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "semanticSetId",
    "semanticSetVersionId",
    "name",
    "versionNumber",
    "members",
    "reviewStatus"
  ],
  "properties": {
    "semanticSetId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "semanticSetVersionId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "versionNumber": {
      "type": "integer",
      "minimum": 1
    },
    "definition": {
      "type": [
        "string",
        "null"
      ]
    },
    "members": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "memberKey",
          "inclusionType",
          "reviewStatus"
        ],
        "properties": {
          "memberObjectType": {
            "type": [
              "string",
              "null"
            ]
          },
          "memberObjectId": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
          },
          "memberKey": {
            "type": "string",
            "minLength": 1
          },
          "inclusionType": {
            "enum": [
              "INCLUDE",
              "EXCLUDE"
            ]
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "confidence": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          },
          "reviewStatus": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "reviewStatus": {
      "type": "string",
      "minLength": 1
    }
  }
}

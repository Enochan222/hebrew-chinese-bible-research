{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hebrew-chinese-bible-research.local/schemas/v1.1/rights-decision-snapshot.schema.json",
  "title": "RightsDecisionSnapshot v1.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "snapshotId",
    "subjectType",
    "subjectIdentifier",
    "operation",
    "purposeScope",
    "audienceScope",
    "commercialContext",
    "applicableRuleIds",
    "winningRuleIds",
    "decision",
    "decisionBasis",
    "resolverVersion",
    "evaluatedAt",
    "decisionHash",
    "obligations"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.1"
    },
    "snapshotId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "subjectType": {
      "enum": [
        "SOURCE_ASSET",
        "WORK",
        "EDITION",
        "TEXTUAL_WORK",
        "TEXTUAL_EDITION",
        "DIGITAL_EXPRESSION",
        "PROVIDER_DISTRIBUTION",
        "CORPUS_RELEASE",
        "ANNOTATION_LAYER",
        "RESEARCH_OBJECT"
      ]
    },
    "subjectIdentifier": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "operation": {
      "enum": [
        "STORE_ORIGINAL",
        "EXTRACT_TEXT",
        "STORE_EXTRACTED_TEXT",
        "EMBED",
        "MODEL_CONTEXT",
        "CACHE",
        "DISPLAY_FULLTEXT",
        "DISPLAY_EXCERPT",
        "QUOTE",
        "EXPORT",
        "REDISTRIBUTE",
        "COMMERCIAL_USE"
      ]
    },
    "purposeScope": {
      "enum": [
        "PRIVATE_RESEARCH",
        "RESEARCH_COMPILATION",
        "PUBLICATION",
        "PUBLIC_DISPLAY",
        "USER_WORKSPACE",
        "MODEL_ASSISTANCE",
        "EXPORT"
      ]
    },
    "audienceScope": {
      "enum": [
        "INTERNAL_SERVICE",
        "PRIVATE_RESEARCHER",
        "AUTHENTICATED_USER",
        "PUBLIC"
      ]
    },
    "commercialContext": {
      "enum": [
        "NONCOMMERCIAL",
        "COMMERCIAL",
        "MIXED",
        "UNKNOWN"
      ]
    },
    "applicableRuleIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
      },
      "uniqueItems": true
    },
    "winningRuleIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
      },
      "uniqueItems": true
    },
    "decision": {
      "enum": [
        "ALLOW",
        "DENY",
        "CONDITIONAL"
      ]
    },
    "conditions": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "./rights-condition.schema.json"
      },
      "uniqueItems": true
    },
    "resolverVersion": {
      "type": "string",
      "minLength": 1
    },
    "evaluatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "decisionHash": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "decisionBasis": {
      "enum": [
        "RULE",
        "DEFAULT_DENY",
        "UNKNOWN_RESTRICTIVE"
      ]
    },
    "obligations": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "obligationType",
              "value"
            ],
            "properties": {
              "obligationType": {
                "const": "ATTRIBUTION"
              },
              "value": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "obligationType",
              "value",
              "unit"
            ],
            "properties": {
              "obligationType": {
                "const": "MAX_EXCERPT"
              },
              "value": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "unit": {
                "enum": [
                  "WORD",
                  "UNICODE_CODEPOINT",
                  "GRAPHEME_CLUSTER",
                  "BYTE",
                  "PERCENT_OF_WORK"
                ]
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "obligationType",
              "value",
              "unit"
            ],
            "properties": {
              "obligationType": {
                "const": "RETENTION_LIMIT"
              },
              "value": {
                "type": "integer",
                "minimum": 0
              },
              "unit": {
                "const": "DAY"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "obligationType"
            ],
            "properties": {
              "obligationType": {
                "const": "AUTHENTICATED_ONLY"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "obligationType",
              "value"
            ],
            "properties": {
              "obligationType": {
                "const": "TERRITORY_LIMIT"
              },
              "value": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 2
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "obligationType"
            ],
            "properties": {
              "obligationType": {
                "const": "TEMPORARY_PROCESSING_ONLY"
              }
            }
          }
        ]
      },
      "uniqueItems": true
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "decisionBasis"
        ],
        "properties": {
          "decisionBasis": {
            "const": "RULE"
          }
        }
      },
      "then": {
        "properties": {
          "winningRuleIds": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "decisionBasis"
        ],
        "properties": {
          "decisionBasis": {
            "const": "DEFAULT_DENY"
          }
        }
      },
      "then": {
        "properties": {
          "winningRuleIds": {
            "maxItems": 0
          },
          "decision": {
            "const": "DENY"
          },
          "conditions": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "array",
                "maxItems": 0
              }
            ]
          },
          "obligations": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "decisionBasis"
        ],
        "properties": {
          "decisionBasis": {
            "const": "UNKNOWN_RESTRICTIVE"
          }
        }
      },
      "then": {
        "properties": {
          "winningRuleIds": {
            "maxItems": 0
          },
          "decision": {
            "const": "DENY"
          },
          "conditions": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "array",
                "maxItems": 0
              }
            ]
          },
          "obligations": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "decision"
        ],
        "properties": {
          "decision": {
            "const": "CONDITIONAL"
          }
        }
      },
      "then": {
        "anyOf": [
          {
            "required": [
              "conditions"
            ],
            "properties": {
              "conditions": {
                "type": "array",
                "minItems": 1
              }
            }
          },
          {
            "required": [
              "obligations"
            ],
            "properties": {
              "obligations": {
                "minItems": 1
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "required": [
          "decision"
        ],
        "properties": {
          "decision": {
            "const": "ALLOW"
          }
        }
      },
      "then": {
        "properties": {
          "conditions": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "array",
                "maxItems": 0
              }
            ]
          },
          "obligations": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}

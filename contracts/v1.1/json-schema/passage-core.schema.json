{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hebrew-chinese-bible-research.local/schemas/v1.1/passage-core.schema.json",
  "title": "PassageCoreV1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "researchReleaseId",
    "referenceSpanId"
  ],
  "properties": {
    "researchReleaseId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "referenceSpanId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "resolvedReference": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "referenceSystemId",
            "referenceSystemCode",
            "referenceLabel"
          ],
          "properties": {
            "referenceSystemId": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
            },
            "referenceSystemCode": {
              "type": "string",
              "minLength": 1
            },
            "referenceLabel": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "dataSource": {
      "enum": [
        "FIXTURE",
        "SERVING"
      ]
    },
    "hebrewText": {
      "type": "string"
    },
    "tokens": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "analysisNodeId",
          "textSegmentId",
          "surface"
        ],
        "properties": {
          "analysisNodeId": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
          },
          "textSegmentId": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
          },
          "surface": {
            "type": "string",
            "minLength": 1
          },
          "lemmaRaw": {
            "type": [
              "string",
              "null"
            ]
          },
          "morphRaw": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "navigation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "previousReference": {
          "type": [
            "string",
            "null"
          ]
        },
        "nextReference": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "attribution": {
      "type": "string",
      "minLength": 1
    }
  },
  "description": "Core passage envelope. Canonical ReferenceSpan identity is always present. A resolved human label is included when the request used a ReferenceSystem-aware label; direct ReferenceSpan requests need not invent a display system. Published Serving responses may add release-pinned Hebrew text, OSHB token morphology, navigation and attribution."
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReleasePointerV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "researchReleaseId",
    "releaseLabel",
    "channel"
  ],
  "properties": {
    "researchReleaseId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "releaseLabel": {
      "type": "string"
    },
    "channel": {
      "enum": [
        "PREVIEW",
        "STAGING",
        "PRODUCTION"
      ]
    }
  }
}

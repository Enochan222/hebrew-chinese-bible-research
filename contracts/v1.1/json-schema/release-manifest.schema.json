{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hebrew-chinese-bible-research.local/schemas/v1.1/release-manifest.schema.json",
  "title": "ResearchRelease Manifest Payload v1.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifestSchemaVersion",
    "researchReleaseId",
    "releaseLabel",
    "sourceBuildId",
    "compilerVersion",
    "gitCommitSha",
    "canonicalSerialization",
    "hashAlgorithm",
    "components"
  ],
  "properties": {
    "manifestSchemaVersion": {
      "const": "1.1"
    },
    "researchReleaseId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "releaseLabel": {
      "type": "string",
      "minLength": 1
    },
    "sourceBuildId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "compilerVersion": {
      "type": "string",
      "minLength": 1
    },
    "gitCommitSha": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$"
    },
    "benchmarkVersion": {
      "type": [
        "string",
        "null"
      ]
    },
    "canonicalSerialization": {
      "const": "RFC8785_JSON_CANONICALIZATION_SCHEME"
    },
    "hashAlgorithm": {
      "const": "SHA256"
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "componentKind",
          "researchObjectId",
          "componentVersion",
          "contentHash",
          "componentOrder"
        ],
        "properties": {
          "componentKind": {
            "enum": [
              "CORPUS",
              "ANNOTATION_FRAMEWORK",
              "ANNOTATION_LAYER",
              "TRANSLATION",
              "SEMANTIC_SET",
              "CONSTRUCTION",
              "RULE_SET",
              "KNOWLEDGE_GRAPH",
              "PUBLISHED_ANALYSIS",
              "CITATION_BIBLIOGRAPHY",
              "COMPILED_SEARCH",
              "SCHOLARLY_ISSUE_GRAPH",
              "LITERATURE_SNAPSHOT",
              "LITERATURE_REVIEW",
              "COMMENTARY",
              "DISCOVERY_BIBLIOGRAPHY",
              "TRANSLATION_SOURCE_BASIS",
              "TRANSLATION_POLICY"
            ]
          },
          "researchObjectId": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
          },
          "componentVersion": {
            "type": "string",
            "minLength": 1
          },
          "contentHash": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{64}$"
          },
          "componentOrder": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}

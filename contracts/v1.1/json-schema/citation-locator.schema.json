{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hebrew-chinese-bible-research.local/schemas/v1.1/citation-locator.schema.json",
  "title": "CitationLocatorV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "locatorType"
  ],
  "properties": {
    "locatorType": {
      "enum": [
        "SOURCE_SPAN",
        "PRINTED_PAGE",
        "SOURCE_ASSET_PAGE",
        "DOCUMENT_SECTION",
        "LEXICON_ENTRY",
        "BIBLICAL_REFERENCE",
        "CORPUS_RESULT"
      ]
    },
    "editionId": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "sourceAssetId": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "sourceSpanId": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "sourceAssetPageId": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "printedPageLabel": {
      "type": [
        "string",
        "null"
      ]
    },
    "sectionPath": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "entryLabel": {
      "type": [
        "string",
        "null"
      ]
    },
    "referenceSpanId": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "corpusQueryRunId": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "boundingBox": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0
        },
        "y": {
          "type": "number",
          "minimum": 0
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "coordinateBasis": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "locatorType": {
            "const": "SOURCE_SPAN"
          }
        }
      },
      "then": {
        "required": [
          "sourceSpanId"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "locatorType": {
            "const": "PRINTED_PAGE"
          }
        }
      },
      "then": {
        "required": [
          "editionId",
          "printedPageLabel"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "locatorType": {
            "const": "SOURCE_ASSET_PAGE"
          }
        }
      },
      "then": {
        "required": [
          "sourceAssetPageId"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "locatorType": {
            "const": "DOCUMENT_SECTION"
          }
        }
      },
      "then": {
        "required": [
          "editionId",
          "sectionPath"
        ],
        "properties": {
          "sectionPath": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "locatorType": {
            "const": "LEXICON_ENTRY"
          }
        }
      },
      "then": {
        "required": [
          "editionId",
          "entryLabel"
        ],
        "properties": {
          "entryLabel": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "locatorType": {
            "const": "BIBLICAL_REFERENCE"
          }
        }
      },
      "then": {
        "required": [
          "referenceSpanId"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "locatorType": {
            "const": "CORPUS_RESULT"
          }
        }
      },
      "then": {
        "required": [
          "corpusQueryRunId"
        ]
      }
    }
  ]
}

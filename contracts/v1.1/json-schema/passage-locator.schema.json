{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hebrew-chinese-bible-research.local/schemas/v1.1/passage-locator.schema.json",
  "title": "PassageLocatorV1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "referenceSpanId"
      ],
      "properties": {
        "referenceSpanId": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "referenceSystemCode",
        "referenceLabel"
      ],
      "properties": {
        "referenceSystemCode": {
          "type": "string",
          "minLength": 1
        },
        "referenceLabel": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hebrew-chinese-bible-research.local/schemas/v1.1/translation-decision.schema.json",
  "title": "TranslationDecision Payload v1.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decisionSchemaVersion",
    "decisionKind",
    "translationSourceBasisId",
    "translationPolicyVersionId",
    "targetLanguageTag",
    "candidateRenderings"
  ],
  "properties": {
    "decisionSchemaVersion": {
      "const": "1.1"
    },
    "decisionKind": {
      "type": "string",
      "minLength": 1
    },
    "selectedRendering": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "ambiguityStrategy": {
      "type": [
        "string",
        "null"
      ]
    },
    "candidateRenderings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidateId",
          "rendering",
          "status"
        ],
        "properties": {
          "candidateId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "rendering": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "SELECTED",
              "ALTERNATIVE",
              "REJECTED",
              "UNRESOLVED"
            ]
          },
          "reasonSummary": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    },
    "translationSourceBasisId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "translationPolicyVersionId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "targetLanguageTag": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hebrew-chinese-bible-research.local/schemas/v1.1/commentary-entry.schema.json",
  "title": "CommentaryEntryV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "commentaryEntryId",
    "researchReleaseId",
    "referenceSpanId",
    "commentaryKind",
    "reviewStatus",
    "contentHash",
    "sections"
  ],
  "properties": {
    "commentaryEntryId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "researchReleaseId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "referenceSpanId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "commentaryKind": {
      "enum": [
        "PASSAGE_COMMENTARY",
        "TEXTUAL_NOTE",
        "GRAMMATICAL_NOTE",
        "LEXICAL_NOTE",
        "LITERARY_NOTE",
        "HISTORICAL_NOTE",
        "TRANSLATION_NOTE",
        "STATE_OF_RESEARCH_NOTE"
      ]
    },
    "title": {
      "type": [
        "string",
        "null"
      ]
    },
    "summary": {
      "type": [
        "string",
        "null"
      ]
    },
    "reviewStatus": {
      "type": "string",
      "minLength": 1
    },
    "contentHash": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sectionId",
          "sectionType",
          "sectionOrder",
          "renderedText",
          "assertionIds"
        ],
        "properties": {
          "sectionId": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
          },
          "sectionType": {
            "enum": [
              "TEXTUAL_STATE",
              "MORPHOLOGY",
              "LEXICON",
              "SYNTAX",
              "CORPUS",
              "TEXTUAL_CRITICISM",
              "LITERARY_CONTEXT",
              "HISTORICAL_CONTEXT",
              "SCHOLARLY_ISSUES",
              "TRANSLATION_IMPLICATIONS",
              "CHINESE_TRANSLATION_DECISION",
              "COUNTERARGUMENTS",
              "UNCERTAINTY"
            ]
          },
          "sectionOrder": {
            "type": "integer",
            "minimum": 0
          },
          "renderedText": {
            "type": "string"
          },
          "assertionIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "evidenceItemIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
            },
            "uniqueItems": true
          }
        }
      }
    }
  }
}

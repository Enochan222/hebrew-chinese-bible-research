{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hebrew-chinese-bible-research.local/schemas/v1.1/experience-capabilities.schema.json",
  "title": "ExperienceCapabilitiesV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "researchReleaseId",
    "experienceModesAllowed",
    "featureDecisions",
    "reasonCodes"
  ],
  "properties": {
    "researchReleaseId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "experienceModesAllowed": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "STUDY",
          "RESEARCH"
        ]
      }
    },
    "featureDecisions": {
      "type": "object",
      "additionalProperties": {
        "enum": [
          "ALLOW",
          "DENY"
        ]
      },
      "propertyNames": {
        "enum": [
          "PASSAGE_STUDY",
          "KEY_SCHOLARSHIP",
          "BASIC_CORPUS_SEARCH",
          "ADVANCED_CORPUS_QUERY",
          "CONSTRUCTION_BROWSER",
          "SCHOLARLY_ISSUE_SUMMARY",
          "SCHOLARLY_DEBATE_GRAPH",
          "FULL_BIBLIOGRAPHY",
          "LITERATURE_REVIEW",
          "LIVE_LITERATURE_DISCOVERY",
          "CITATION_DEPENDENCY_GRAPH",
          "ADVANCED_TEXTUAL_CRITICISM",
          "RESEARCH_EXPORT",
          "SAVED_RESEARCH_PROJECTS",
          "OPTIONAL_AI_QUERY_INTERPRETATION"
        ]
      }
    },
    "reasonCodes": {
      "type": "object",
      "additionalProperties": {
        "enum": [
          "FEATURE_NOT_ENTITLED",
          "SOURCE_RIGHTS_RESTRICTED",
          "NOT_IN_RESEARCH_RELEASE",
          "NOT_YET_REVIEWED",
          "DISCOVERY_PROVIDER_UNAVAILABLE",
          "COVERAGE_NOT_AVAILABLE",
          "DATA_TEMPORARILY_UNAVAILABLE"
        ]
      },
      "propertyNames": {
        "enum": [
          "PASSAGE_STUDY",
          "KEY_SCHOLARSHIP",
          "BASIC_CORPUS_SEARCH",
          "ADVANCED_CORPUS_QUERY",
          "CONSTRUCTION_BROWSER",
          "SCHOLARLY_ISSUE_SUMMARY",
          "SCHOLARLY_DEBATE_GRAPH",
          "FULL_BIBLIOGRAPHY",
          "LITERATURE_REVIEW",
          "LIVE_LITERATURE_DISCOVERY",
          "CITATION_DEPENDENCY_GRAPH",
          "ADVANCED_TEXTUAL_CRITICISM",
          "RESEARCH_EXPORT",
          "SAVED_RESEARCH_PROJECTS",
          "OPTIONAL_AI_QUERY_INTERPRETATION"
        ]
      }
    },
    "validUntil": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hebrew-chinese-bible-research.local/schemas/v1.1/translation-witness-list.schema.json",
  "title": "Translation Witness List v1.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "researchReleaseId",
    "referenceSpanId",
    "resolvedReference",
    "witnesses"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.1"
    },
    "researchReleaseId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "referenceSpanId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "resolvedReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "referenceSystemId",
        "referenceSystemCode",
        "referenceLabel"
      ],
      "properties": {
        "referenceSystemId": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
        },
        "referenceSystemCode": {
          "type": "string",
          "minLength": 1
        },
        "referenceLabel": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "witnesses": {
      "type": "array",
      "items": {
        "$ref": "./translation-witness.schema.json"
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hebrew-chinese-bible-research.local/schemas/v1.1/construction-compilation-run.schema.json",
  "title": "ConstructionCompilationRun v1.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "compilationRunId",
    "constructionDefinitionVersionId",
    "corpusReleaseId",
    "queryAstHash",
    "dependencyManifest",
    "compilerVersion",
    "status"
  ],
  "properties": {
    "compilationRunId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "constructionDefinitionVersionId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "corpusReleaseId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "queryAstHash": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "dependencyManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "annotationLayerIds",
        "semanticSetVersionIds",
        "normalizationProfileIds",
        "relationTypes"
      ],
      "properties": {
        "annotationLayerIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
          }
        },
        "semanticSetVersionIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
          }
        },
        "normalizationProfileIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
          }
        },
        "relationTypes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "compilerVersion": {
      "type": "string",
      "minLength": 1
    },
    "startedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "completedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "resultCount": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "resultSetHash": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "status": {
      "enum": [
        "QUEUED",
        "RUNNING",
        "FAILED",
        "COMPLETED"
      ]
    }
  }
}
